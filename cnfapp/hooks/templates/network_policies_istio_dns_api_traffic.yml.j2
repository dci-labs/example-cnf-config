      apiVersion: v1
      kind: List
      items:
        - kind: NetworkPolicy
          apiVersion: networking.k8s.io/v1
          metadata:
            name: allow-istio-ingress
            namespace: "{{ ecd_cnf_namespace }}"
          spec:
            podSelector: {}
            ingress:
              - from:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: istio-system
            egress:
              - to:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: "{{ ecd_cnf_namespace }}"
        - kind: NetworkPolicy
          apiVersion: networking.k8s.io/v1
          metadata:
            name: allow-istio-egress
            namespace: "{{ ecd_cnf_namespace }}"
          spec:
            podSelector: {}
            ingress:
              - from:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: "{{ ecd_cnf_namespace }}"
            egress:
              - to:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: istio-system
        - kind: NetworkPolicy
          apiVersion: networking.k8s.io/v1
          metadata:
            name: allow-dns-ingress
            namespace: "{{ ecd_cnf_namespace }}"
          spec:
            podSelector: {}
            ingress:
              - from:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: openshift-dns
            egress:
              - to:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: "{{ ecd_cnf_namespace }}"
        - kind: NetworkPolicy
          apiVersion: networking.k8s.io/v1
          metadata:
            name: allow-dns-egress
            namespace: "{{ ecd_cnf_namespace }}"
          spec:
            podSelector: {}
            ingress:
              - from:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: "{{ ecd_cnf_namespace }}"
            egress:
              - to:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: openshift-dns
        - kind: NetworkPolicy
          apiVersion: networking.k8s.io/v1
          metadata:
            name: allow-apiserver-egress
            namespace: "{{ ecd_cnf_namespace }}"
          spec:
            # Only operator controllers need kube-apiserver; dataplane pods stay default-deny.
            podSelector:
              matchLabels:
                control-plane: controller-manager
            policyTypes:
              - Egress
            egress:
              - to:
{% for cidr in ecd_apiserver_cidrs | default([]) %}
                  - ipBlock:
                      cidr: "{{ cidr }}"
{% endfor %}
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: openshift-kube-apiserver
                ports:
                  - protocol: TCP
                    port: 6443
                  - protocol: TCP
                    port: 443
