      apiVersion: v1
      kind: List
      items:
        - kind: NetworkPolicy
          apiVersion: networking.k8s.io/v1
          metadata:
            name: allow-istio-ingress
            namespace: "{{ ecd_cnf_namespace }}"
          spec:
            podSelector: {}
            ingress:
              - from:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: istio-system
            egress:
              - to:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: "{{ ecd_cnf_namespace }}"
        - kind: NetworkPolicy
          apiVersion: networking.k8s.io/v1
          metadata:
            name: allow-istio-egress
            namespace: "{{ ecd_cnf_namespace }}"
          spec:
            podSelector: {}
            ingress:
              - from:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: "{{ ecd_cnf_namespace }}"
            egress:
              - to:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: istio-system
        - kind: NetworkPolicy
          apiVersion: networking.k8s.io/v1
          metadata:
            name: allow-dns-ingress
            namespace: "{{ ecd_cnf_namespace }}"
          spec:
            podSelector: {}
            ingress:
              - from:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: openshift-dns
            egress:
              - to:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: "{{ ecd_cnf_namespace }}"
        - kind: NetworkPolicy
          apiVersion: networking.k8s.io/v1
          metadata:
            name: allow-dns-egress
            namespace: "{{ ecd_cnf_namespace }}"
          spec:
            podSelector: {}
            ingress:
              - from:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: "{{ ecd_cnf_namespace }}"
            egress:
              - to:
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: openshift-dns
{# Operators and dataplane pods that call the kube API in-cluster
   (trex-cfg-configure, trexmac/trexevent, retrieve-grout-ip-addresses).
   Keep allow-apiserver-egress name for controller-manager so upgrades
   replace the previous single policy in place. #}
{% set ecd_apiserver_egress_selectors = [
  {'name': 'allow-apiserver-egress', 'matchLabels': {'control-plane': 'controller-manager'}},
  {'name': 'allow-apiserver-egress-pkt-gen', 'matchLabels': {'example-cnf-type': 'pkt-gen'}},
  {'name': 'allow-apiserver-egress-pkt-gen-app', 'matchLabels': {'example-cnf-type': 'pkt-gen-app'}},
  {'name': 'allow-apiserver-egress-cnf-app', 'matchLabels': {'example-cnf-type': 'cnf-app'}},
] %}
{% for selector in ecd_apiserver_egress_selectors %}
        - kind: NetworkPolicy
          apiVersion: networking.k8s.io/v1
          metadata:
            name: {{ selector.name }}
            namespace: "{{ ecd_cnf_namespace }}"
          spec:
            podSelector:
              matchLabels:
{% for key, value in selector.matchLabels.items() %}
                {{ key }}: {{ value }}
{% endfor %}
            policyTypes:
              - Egress
            egress:
              - to:
{% for cidr in ecd_apiserver_cidrs | default([]) %}
                  - ipBlock:
                      cidr: "{{ cidr }}"
{% endfor %}
                  - namespaceSelector:
                      matchLabels:
                        kubernetes.io/metadata.name: openshift-kube-apiserver
                ports:
                  - protocol: TCP
                    port: 6443
                  - protocol: TCP
                    port: 443
{% endfor %}
